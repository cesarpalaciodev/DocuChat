# DocuChat - Production environment
# Copy this to Railway Variables or your production env

HOST=0.0.0.0
PORT=8000

# JWT Secret - GENERATE A NEW ONE! NEVER use this default
# Run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=119856d67fcf42bb921aa56c5cc58cded8a8eaeab1cf1842dd63a3d6978acb45
JWT_EXPIRE_MINUTES=1440

# Security
AUTH_ENABLED=true
ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
CORS_ORIGINS=https://docuchat.up.railway.app
RATE_LIMIT_ENABLED=true
RATE_LIGHT_RPM=300
RATE_MEDIUM_RPM=60
RATE_HEAVY_RPM=20
RATE_EXPENSE_RPM=5

# Server LLM key (OPTIONAL - only for health check monitoring)
# If not set, users must provide their own key via Settings
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3-8b-instruct

# Backend settings
WORKERS=1
LLM_TIMEOUT_SECONDS=60
LLM_STREAM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
MAX_CONCURRENT_CLONES=3
CLONE_TIMEOUT_SECONDS=60
MAX_TOTAL_CHUNKS=20000
MAX_FILE_SIZE=500000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
